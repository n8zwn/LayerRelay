+function ledEffectiveState(printerState) {
+  const s = String(printerState || '').toUpperCase();
+  let base;
+  if (s === 'ERROR') base = 'error';
+  else if (s === 'PRINTING' || s === 'PAUSED') base = 'printing';
+  else if (s === 'FINISHED') base = 'finished';
+  else base = 'idle';
